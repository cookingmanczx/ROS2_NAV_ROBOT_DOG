<?xml version="1.0"?>
<robot name="a2_lidar" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Official Unitree A2 description (plain URDF, root link = base_link) -->
  <xacro:include filename="$(find a2_description)/urdf/a2.urdf"/>

  <!--
    2D lidar mounted just above the top of the A2 body.
    base_link.STL bounding box: z in [-0.080, 0.130], so the body top is at 0.130.
    lidar_link is placed at z = 0.16 (3 cm clearance above the body, no intersection).
  -->
  <link name="lidar_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.05" length="0.05"/>
      </geometry>
      <material name="lidar_dark">
        <color rgba="0.25 0.25 0.25 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.05" length="0.05"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.1"/>
      <inertia ixx="8.333e-05" ixy="0.0" ixz="0.0"
               iyy="8.333e-05" iyz="0.0"
               izz="1.25e-04"/>
    </inertial>
  </link>

  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin xyz="0 0 0.16" rpy="0 0 0"/>
  </joint>

  <gazebo reference="lidar_link">
    <sensor type="ray" name="a2_lidar">
      <update_rate>10</update_rate>
      <visualize>false</visualize>
      <ray>
        <scan>
          <horizontal>
            <samples>180</samples>
            <resolution>1</resolution>
            <min_angle>-3.1415926</min_angle>
            <max_angle>3.1415926</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.1</min>
          <max>12.0</max>
          <resolution>0.01</resolution>
        </range>
      </ray>
      <plugin name="a2_lidar_plugin" filename="libgazebo_ros_ray_sensor.so">
        <ros>
          <remapping>~/out:=scan</remapping>
        </ros>
        <output_type>sensor_msgs/LaserScan</output_type>
        <frame_name>lidar_link</frame_name>
      </plugin>
    </sensor>
  </gazebo>

  <!-- Static model: pose is driven externally (SetEntityState), no joint control needed -->
  <gazebo>
    <static>true</static>
  </gazebo>

</robot>
