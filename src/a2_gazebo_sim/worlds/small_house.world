<?xml version="1.0"?>
<sdf version="1.6">
  <world name="small_house">

    <include>
      <uri>model://sun</uri>
    </include>

    <include>
      <uri>model://ground_plane</uri>
    </include>

    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>true</shadows>
    </scene>

    <!-- gazebo_ros_state: provides /set_entity_state and /get_entity_state
         so the static A2 model can be teleported by cmd_vel_driver -->
    <plugin name="gazebo_ros_state" filename="libgazebo_ros_state.so">
      <ros>
        <namespace>/</namespace>
      </ros>
      <update_rate>1000.0</update_rate>
    </plugin>

    <!-- ==================== Outer walls: 8 m x 8 m, 0.2 m thick, 1.5 m high ==================== -->
    <model name="wall_outer_north">
      <static>true</static>
      <pose>0 4 0.75 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>8.4 0.2 1.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>8.4 0.2 1.5</size></box></geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.9 0.9 0.9 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="wall_outer_south">
      <static>true</static>
      <pose>0 -4 0.75 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>8.4 0.2 1.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>8.4 0.2 1.5</size></box></geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.9 0.9 0.9 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="wall_outer_west">
      <static>true</static>
      <pose>-4 0 0.75 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.2 8.4 1.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.2 8.4 1.5</size></box></geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.9 0.9 0.9 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="wall_outer_east">
      <static>true</static>
      <pose>4 0 0.75 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.2 8.4 1.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.2 8.4 1.5</size></box></geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.9 0.9 0.9 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ============ Internal wall separating living room (y < 2) from two bedrooms ============ -->
    <!-- Door opening 1: x in [-2, -1], Door opening 2: x in [1, 2] -->

    <model name="wall_inner_h_a">
      <static>true</static>
      <pose>-3 2 0.75 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>2.0 0.2 1.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>2.0 0.2 1.5</size></box></geometry>
          <material>
            <ambient>0.7 0.7 0.7 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="wall_inner_h_b">
      <static>true</static>
      <pose>0 2 0.75 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>2.0 0.2 1.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>2.0 0.2 1.5</size></box></geometry>
          <material>
            <ambient>0.7 0.7 0.7 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="wall_inner_h_c">
      <static>true</static>
      <pose>3 2 0.75 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>2.0 0.2 1.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>2.0 0.2 1.5</size></box></geometry>
          <material>
            <ambient>0.7 0.7 0.7 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Vertical wall between the two bedrooms (x = 0, y > 2), door opening y in [2.8, 3.8] -->
    <model name="wall_inner_v_a">
      <static>true</static>
      <pose>0 2.45 0.75 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.2 0.7 1.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.2 0.7 1.5</size></box></geometry>
          <material>
            <ambient>0.7 0.7 0.7 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="wall_inner_v_b">
      <static>true</static>
      <pose>0 3.9 0.75 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.2 0.2 1.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.2 0.2 1.5</size></box></geometry>
          <material>
            <ambient>0.7 0.7 0.7 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ==================== Furniture (static boxes) ==================== -->
    <model name="furniture_table">
      <static>true</static>
      <pose>-2.0 -2.0 0.45 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>1.4 0.9 0.9</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.4 0.9 0.9</size></box></geometry>
          <material>
            <ambient>0.35 0.22 0.12 1</ambient>
            <diffuse>0.45 0.30 0.16 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="furniture_sofa">
      <static>true</static>
      <pose>0.0 -3.0 0.45 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>1.8 0.8 0.9</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.8 0.8 0.9</size></box></geometry>
          <material>
            <ambient>0.35 0.15 0.15 1</ambient>
            <diffuse>0.5 0.2 0.2 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="furniture_cabinet">
      <static>true</static>
      <pose>3.1 0.9 0.55 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.6 0.5 1.1</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.6 0.5 1.1</size></box></geometry>
          <material>
            <ambient>0.2 0.25 0.35 1</ambient>
            <diffuse>0.25 0.32 0.45 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="furniture_bookshelf">
      <static>true</static>
      <pose>-3.2 1.0 0.6 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.4 1.4 1.2</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.4 1.4 1.2</size></box></geometry>
          <material>
            <ambient>0.3 0.25 0.18 1</ambient>
            <diffuse>0.4 0.33 0.22 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="furniture_wardrobe">
      <static>true</static>
      <pose>-1.5 3.4 0.6 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.8 0.6 1.2</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.8 0.6 1.2</size></box></geometry>
          <material>
            <ambient>0.35 0.3 0.25 1</ambient>
            <diffuse>0.45 0.38 0.3 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
